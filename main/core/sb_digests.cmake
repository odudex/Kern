# Writes kern_sb_digests.h from the published Secure Boot key digests in
# kern_secure_boot/. A build signed with other keys replaces those three files
# (espsecure digest-sbv2-public-key), or passes -DKERN_SB_DIGEST_DIR.
if(NOT KERN_SB_DIGEST_DIR)
  set(KERN_SB_DIGEST_DIR ${CMAKE_CURRENT_LIST_DIR}/../../kern_secure_boot)
endif()

function(kern_generate_sb_digests out_dir)
  set(rows "")
  foreach(i 0 1 2)
    set(bin ${KERN_SB_DIGEST_DIR}/kern-sb-digest${i}.bin)
    file(READ ${bin} hex HEX)
    string(LENGTH "${hex}" hex_len)
    if(NOT hex_len EQUAL 64)
      message(FATAL_ERROR "${bin} must hold a 32-byte digest")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1, " bytes "${hex}")
    string(APPEND rows "    {${bytes}},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${bin})
  endforeach()

  set(header ${out_dir}/kern_sb_digests.h)
  set(content "/* Generated by main/core/sb_digests.cmake from kern_secure_boot/ */
#pragma once
#include <stdint.h>

static const uint8_t KERN_SB_DIGESTS[3][32] = {
${rows}};
")
  set(old "")
  if(EXISTS ${header})
    file(READ ${header} old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE ${header} "${content}")
  endif()
endfunction()
