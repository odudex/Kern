# Board: LilyGO T-Display-P4 AMOLED (568x1232 MIPI DSI, RM69A10 + GT9895)
CONFIG_KERN_BOARD_TDISPLAY_P4=y
# Font sizes chosen by tools/ui_font_policy.py for a 568x1232 panel.
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Camera: OV2710 (2 MP MIPI-CSI) replaces the OV5647/SC2336 used by other boards.
CONFIG_CAMERA_OV5647=n
CONFIG_CAMERA_SC2336=n
CONFIG_CAMERA_OV2710=y
CONFIG_CAMERA_OV2710_MIPI_RAW10_1920X1080_25FPS=n
CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y
CONFIG_CAMERA_OV2710_MIPI_DEFAULT_FMT_RAW10_1280X720_25FPS=y
# RAW10 sensor needs the ISP pipeline (AWB/AGC/CCM) for a usable RGB image.
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
