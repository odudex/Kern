# ESP32-P4 chip revision v3.x overlay, applied by `just build <board>_v3`.
# IDF supports either v0.x/v1.x or v3.x silicon per image, never both.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
# 200MHz PSRAM gave load/store access faults on a v3.2 wave_43 (QR scan, boot); 80MHz is stable until v3 hardware is on hand to tune it.
CONFIG_SPIRAM_SPEED_80M=y
